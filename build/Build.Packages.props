<Project>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BlackFox.Fake.BuildTask" Version="0.1.3" />
    <PackageVersion Include="Fake.Core.Process" Version="6.2.0" />
    <PackageVersion Include="Fake.Core.ReleaseNotes" Version="6.2.0" />
    <PackageVersion Include="Fake.Core.Target" Version="6.2.0" />
    <PackageVersion Include="Fake.DotNet.Cli" Version="6.2.0" />
    <PackageVersion Include="Fake.IO.FileSystem" Version="6.2.0" />
    <PackageVersion Include="Fake.JavaScript.Npm" Version="6.2.0" />
    <PackageVersion Include="Fake.Tools.Git" Version="6.2.0" />
    <PackageVersion Include="Fake.Extensions.Release" Version="1.0.0" />
    <!-- FAKE currently brings older vulnerable versions of these build-only dependencies. -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.13" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
