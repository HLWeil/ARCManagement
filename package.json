{
  "name": "arcmanagement",
  "version": "0.0.1",
  "description": "F# library for managing ARCs (Annotated Research Contexts), published for .NET, JavaScript, and Python.",
  "type": "module",
  "license": "MIT",
  "author": "Heinrich Lukas Weil <weil@rptu.de> (https://github.com/HLWeil)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HLWeil/ARCManagement.git"
  },
  "homepage": "https://github.com/HLWeil/ARCManagement#readme",
  "bugs": { "url": "https://github.com/HLWeil/ARCManagement/issues" },
  "keywords": ["fsharp", "fable", "arc", "annotated-research-context", "research-data-management"],
  "main": "./dist/ts/index.js",
  "module": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/ts/index.js"
    }
  },
  "files": ["dist/ts"],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fable-org/fable-library-ts": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@typescript/typescript6": "6.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5"
  }
}
