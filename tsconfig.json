{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/ts",
    "rootDir": "src/PolyglotTemplate",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": ["src/PolyglotTemplate/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
