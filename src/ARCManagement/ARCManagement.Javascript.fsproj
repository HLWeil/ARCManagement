<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Package.Metadata.props" />
  <PropertyGroup>
    <PackageId>ARCManagement.Javascript</PackageId>
    <PackageTags>FSharp;Fable;ARC;RDM;fable-javascript;fable-typescript</PackageTags>
    <DefineConstants>$(DefineConstants);FABLE_COMPILER;FABLE_COMPILER_JAVASCRIPT;FABLE_COMPILER_TYPESCRIPT</DefineConstants>
  </PropertyGroup>
  <Import Project="ARCManagement.Common.props" />
  <ItemGroup>
    <PackageReference Include="Fable.Promise" />
  </ItemGroup>
</Project>
